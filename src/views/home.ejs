<%- include("partials/header", { title: "Home" }) %>
<div class="p-4 p-md-5 mb-4 bg-white rounded-3 shadow-sm">
  <h1 class="display-6 fw-bold">Useful gear. Straightforward shopping.</h1>
  <p class="lead mb-0">A demo storefront we'll use to learn real-world application delivery.</p>
</div>
<h2 class="h4 mb-3">Products</h2>
<div class="row g-4">
  <% products.forEach(product => { %>
    <div class="col-sm-6 col-lg-3">
      <div class="card h-100 shadow-sm">
        <img src="<%= product.imageUrl || 'https://placehold.co/640x420' %>" class="card-img-top" alt="<%= product.name %>">
        <div class="card-body d-flex flex-column">
          <h3 class="h5"><%= product.name %></h3>
          <p class="text-muted small"><%= product.description %></p>
          <p class="fw-bold mt-auto"><%= money(product.priceCents) %></p>
          <a href="/products/<%= product.id %>" class="btn btn-dark">View product</a>
        </div>
      </div>
    </div>
  <% }) %>
</div>
<%- include("partials/footer") %>
