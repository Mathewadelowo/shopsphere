<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || "ShopSphere" %> | ShopSphere</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">ShopSphere</a>
    <div class="d-flex align-items-center gap-3">
      <a class="text-white text-decoration-none" href="/cart">Cart (<%= cartCount %>)</a>
      <% if (user) { %>
        <a class="text-white text-decoration-none" href="/orders">My orders</a>
        <span class="text-white-50">Hi, <%= user.name %></span>
        <form method="post" action="/logout" class="m-0"><button class="btn btn-sm btn-outline-light">Logout</button></form>
      <% } else { %>
        <a class="text-white text-decoration-none" href="/login">Login</a>
        <a class="btn btn-sm btn-warning" href="/register">Register</a>
      <% } %>
    </div>
  </div>
</nav>
<main class="container py-4">
