<%- include("partials/header", { title: "Order details" }) %>
<h1 class="h2">Order confirmed</h1>
<p class="text-muted">Order reference: <%= order.id %></p>
<div class="bg-white rounded-3 shadow-sm p-3">
  <% order.items.forEach(item => { %>
    <div class="d-flex justify-content-between border-bottom py-2">
      <span><%= item.product.name %> × <%= item.quantity %></span>
      <strong><%= money(item.unitPriceCents * item.quantity) %></strong>
    </div>
  <% }) %>
  <div class="d-flex justify-content-between pt-3 fs-5"><strong>Total</strong><strong><%= money(order.totalCents) %></strong></div>
</div>
<a class="btn btn-dark mt-3" href="/orders">View all orders</a>
<%- include("partials/footer") %>
