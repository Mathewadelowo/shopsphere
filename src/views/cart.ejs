<%- include("partials/header", { title: "Your cart" }) %>
<h1 class="h2 mb-4">Your cart</h1>
<% if (!items.length) { %>
  <div class="alert alert-info">Your cart is empty. <a href="/">Browse products</a>.</div>
<% } else { %>
  <div class="bg-white rounded-3 shadow-sm p-3">
    <% items.forEach(item => { %>
      <div class="d-flex justify-content-between align-items-center border-bottom py-3 gap-3">
        <div><strong><%= item.product.name %></strong><div class="text-muted small">Quantity: <%= item.quantity %></div></div>
        <div class="text-end"><strong><%= money(item.lineTotal) %></strong>
          <form method="post" action="/cart/<%= item.product.id %>/remove"><button class="btn btn-sm btn-link text-danger">Remove</button></form>
        </div>
      </div>
    <% }) %>
    <div class="d-flex justify-content-between py-3 fs-5"><strong>Total</strong><strong><%= money(totalCents) %></strong></div>
    <% if (user) { %>
      <form method="post" action="/checkout"><button class="btn btn-success">Place order</button></form>
    <% } else { %>
      <a class="btn btn-dark" href="/login">Login to checkout</a>
    <% } %>
  </div>
<% } %>
<%- include("partials/footer") %>
